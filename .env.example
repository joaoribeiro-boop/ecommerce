# Credenciais da sua aplicação do Mercado Livre.
# Crie a aplicação em: https://developers.mercadolivre.com.br/devcenter
# Depois copie este arquivo para ".env" e preencha os valores.

ML_CLIENT_ID=seu_client_id_aqui
ML_CLIENT_SECRET=seu_client_secret_aqui

# Deve ser EXATAMENTE igual ao "URI de redirect" cadastrado na sua aplicação.
ML_REDIRECT_URI=http://localhost:3000/auth/callback

# Porta do servidor local (opcional, padrão 3000).
PORT=3000

# Domínio de autorização conforme o país (opcional).
#   Brasil:    auth.mercadolivre.com.br   (padrão)
#   Argentina: auth.mercadolibre.com.ar
#   México:    auth.mercadolibre.com.mx
ML_AUTH_DOMAIN=auth.mercadolivre.com.br
